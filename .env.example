OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4.1-mini

COMPANY_TIMEZONE=Europe/Berlin
# Optional absolute SQLite path (default: data/company.db)
# COMPANY_DB_PATH=/absolute/path/company.db

# Local Studio demo: disabled unless developer explicitly opts in.
STUDIO_DEMO_ENABLED=0
STUDIO_DEMO_USER=ahmed
# Opt-in bounded human context, Studio only. Default preserves independent turns.
STUDIO_CONVERSATION_MEMORY_ENABLED=false
# Keep cloud tracing off for the fictional local demo.
LANGSMITH_TRACING=false
LANGCHAIN_TRACING_V2=false
